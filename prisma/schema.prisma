generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id             String          @id @default(cuid())
  name           String
  slackId        String          @unique
  onLeaveDays    String          @default("[]")
  assignments    Assignment[]
  breakSchedules BreakSchedule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model BreakSchedule {
  id         String   @id @default(cuid())
  employeeId String
  dayOfWeek  Int      // 0 (Sun) to 6 (Sat)
  startTime  String   // e.g. "13:30"
  endTime    String   // e.g. "14:15"
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model Category {
  id           String       @id @default(uuid())
  name         String
  icon         String?
  excludedDays String?      @default("")
  order        Int          @default(0)
  assignments  Assignment[]
}

model Assignment {
  id         String   @id @default(cuid())
  dayOfWeek  Int      // 0 (Sun) to 6 (Sat)
  categoryId String
  employeeId String
  note       String?  // e.g., "p-2", "till 1 pm"
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Config {
  id                 String  @id @default(cuid())
  postTime           String  @default("08:00") // 24h format
  isAutomationActive Boolean @default(true)
  timezone           String  @default("Asia/Dubai")
  slackChannel       String  @default("")
  slackMessageHeader String  @default("🚀 *Today's Task Assignments*")
  workingDays        String  @default("1,2,3,4,5") // Comma-separated days 0=Sun, 1=Mon, etc.
}
