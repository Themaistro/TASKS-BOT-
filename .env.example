# ─────────────────────────────────────────────────────────
# Tradeling Task Bot - Environment Variables
# ─────────────────────────────────────────────────────────

# Slack Tokens (Found in api.slack.com/apps)
# SLACK_BOT_TOKEN must start with xoxb-
SLACK_BOT_TOKEN="xoxb-your-bot-token"

# SLACK_APP_TOKEN must start with xapp-
SLACK_APP_TOKEN="xapp-your-app-token"

# Slack Channel ID (Right-click channel -> Copy Link -> Last segment)
SLACK_CHANNEL_ID="C0XXXXXXXXX"

# Database Connection (SQLite by default)
# For production, this can be mapped to a persistent volume or swapped to PostgreSQL
DATABASE_URL="file:./dev.db"
